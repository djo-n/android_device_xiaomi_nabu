// Installing this module keeps every module in overrides out of the build.
prebuilt_etc {
    name: "nabu_debloat",
    src: "nabu_debloat.txt",
    vendor: true,
    overrides: [
        "Backgrounds",
        "Camelot",
        "DeviceAsWebcam",
        "EmergencyInfo",
        "Etar",
        "ExactCalculator",
        "Gallery2",
        "Jelly",
        "Profiles",
        "QuickAccessWallet",
        "Recorder",
        "SecureElement",
        "SimpleSettingsConfig",
        "Twelve",
    ],
}
